# FastAPI admin bridge configuration. All values are REQUIRED (fail-fast).

# Where this admin backend listens
HOST=0.0.0.0
PORT=8000

# Media server (Socket.IO) location — same Pi, reached internally
MEDIA_SERVER_URL=http://localhost:4000

# Admin password hash — MUST be the SAME scrypt hash as the media server's
# ADMIN_PASSWORD_HASH. Generate it with the media server's tool:
#   npm run hash-password -- 'your-password'
ADMIN_PASSWORD_HASH=

# Long random value used to sign session cookies
SESSION_SECRET=

# Session lifetime in seconds (12h)
SESSION_MAX_AGE=43200

# Mark the session cookie Secure — set true when served over HTTPS
COOKIE_SECURE=false
# Scheduled flow definitions (JSON array; see schedules.json)
SCHEDULES_FILE_PATH=./schedules.json
